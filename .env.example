# ============================================================
# DATABASE (required)
# ============================================================
# Free Postgres from https://neon.tech - create a project, copy the
# connection string it gives you (starts with postgresql://...). Tables
# are created automatically on first run. This is what makes the bot
# resume its real balance/history after a restart instead of losing it.
DATABASE_URL=postgresql://neondb_owner:npg_Q8Sr6MFynUAB@ep-red-cloud-ayjnt90q-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ============================================================
# MODE
# ============================================================
# true  = paper trading. Uses REAL live Jupiter quotes (real market
#         data) but never signs or sends a transaction, and never
#         needs a funded wallet. Safe to run first.
# false = LIVE trading with a real wallet and real funds.
SIMULATION_MODE=true

# ============================================================
# CAPITAL
# ============================================================
STARTING_CAPITAL_USD=108

# true  = each cycle trades the ENTIRE current USDC/SOL balance
#         (fees compound onto a shrinking balance, fastest to see decay)
# false = each cycle trades a fixed TRADE_AMOUNT_USDC instead
#         (rest of the capital just sits idle in USDC)
USE_FULL_BALANCE=true
TRADE_AMOUNT_USDC=10

# ============================================================
# TIMING
# ============================================================
HOLD_SECONDS=5
COOLDOWN_SECONDS=5

# ============================================================
# SOLANA (required only when SIMULATION_MODE=false)
# ============================================================
# Public RPC is heavily rate-limited. For live use, get a free RPC
# endpoint from Helius, QuickNode, or similar and put it here.
RPC_URL=https://api.mainnet-beta.solana.com

# Base58 private key of the trading wallet. NEVER commit this file
# or share this value with anyone. Keep this wallet's balance small.
PRIVATE_KEY=

# ============================================================
# JUPITER
# ============================================================
# Leave blank to use the free lite-api.jup.ag tier (no key needed,
# rate-limited to ~60 req/60s). Get a key at https://portal.jup.ag
# if you outgrow the free tier.
JUPITER_API_KEY=
SLIPPAGE_BPS=50

# ============================================================
# TELEGRAM
# ============================================================
# Create a bot via @BotFather, then message it once and hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_EVERY_N_CYCLES=1
